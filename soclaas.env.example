# 复制为 soclaas.env（与 server.py 同一文件夹），填好后重启 QuantScope。
# soclaas.env 只保存在你自己的电脑上；不要上传到 GitHub、不要发给别人。
SOCLAAS_API_KEY=在 https://soclaas-portal.comp.nus.edu.sg 生成的 key
SOCLAAS_BASE_URL=https://（SoCLaaS 文档里的 API 地址，通常以 /v1 结尾）
SOCLAAS_MODEL=x-test-1
# x-test-1 下线时自动改用这个（SoCLaaS 的稳定别名）
SOCLAAS_FALLBACK_MODEL=default
